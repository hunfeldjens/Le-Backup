host: backup.example.org
port: 22
username: backup_user

# key = SSH-Schlüssel; password = Passwort aus einer getrennten Datei.
auth: key
private_key: backup_ed25519
known_hosts_file: known_hosts
connect_timeout: 30

# Für Passwort-Anmeldung auth auf password ändern und diese Zeile aktivieren.
# password_file: rsync-password
